# Long random string used to sign admin session cookies
ADMIN_SESSION_SECRET=

# Public base URL (e.g. http://localhost:3001)
APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Initial admin account—used to seed the MongoDB users collection
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/nagas-resort?retryWrites=true&w=majority

# SMTP (emailing the temporary password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smtp-user@example.com
SMTP_PASS=your-app-password-here
